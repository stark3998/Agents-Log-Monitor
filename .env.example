# ─────────────────────────────────────────────────────────────────────────────
# Agent Monitor configuration
#
#   Copy-Item .env.example .env      (macOS/Linux: cp .env.example .env)
#
# Read on startup by the server (npm start / npm run dev / start.ps1), the MCP stdio
# server, the governance MCP gateway, the Electron tray app, the Vite dev server/build
# (VITE_* and AGENT_MONITOR_URL) and the Python intelligence service.
#
# • Everything is optional. With nothing set the monitor runs as a local enforcer with
#   deterministic lanes only (no LLM judge, no Prompt Shields, no cloud sync).
# • Variables already set in your shell win over this file. Empty values are ignored,
#   so a blank `KEY=` keeps the built-in default.
# • Quote values that contain `#` or spaces, e.g. KEY="a#b c".
# • Restart the process after editing. Keep .env out of git (it is ignored) — it may hold secrets.
# • Set AGENT_MONITOR_ENV_FILE in your shell to use a different file, or `none` to skip it.
#   The installed desktop app reads %APPDATA%\Agent Monitor\.env instead of the repo root.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server & storage ─────────────────────────────────────────────────────────
# HTTP/WebSocket port.
# PORT=4317
# Bind address. Defaults to 127.0.0.1 locally and 0.0.0.0 when AGENT_MONITOR_MODE=cloud.
# HOST=127.0.0.1
# SQLite database file (WAL mode; -wal/-shm files sit beside it).
# AGENT_MONITOR_DB=./agent-monitor.db
# Folder containing the built web UI (default: <repo>/public).
# AGENT_MONITOR_PUBLIC=
# Heuristics tuning file (default: agent-monitor.rules.json next to the database).
# AGENT_MONITOR_RULES=
# Payload redaction: off | secrets | all  (all also masks email addresses).
# REDACT_PAYLOADS=secrets
# Set to `production` to stop accepting the Vite dev-server origin (:5173) on loopback.
# NODE_ENV=


# ── Copilot CLI log collector ────────────────────────────────────────────────
# COPILOT_CLI_ENABLED=true
# Copilot home folder (default: ~/.copilot).
# COPILOT_HOME=
# Days of history imported on first start.
# COPILOT_CLI_IMPORT_DAYS=7
# COPILOT_CLI_POLL_INTERVAL_MS=2000


# ── Azure credentials (DefaultAzureCredential) ───────────────────────────────
# Used by the Foundry / Copilot Studio collectors, the judge, Prompt Shields, Cosmos,
# ACS email and the intelligence service when no API key is configured.
# Prefer `az login` (developer machines) or managed identity (Azure) over a client secret.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=


# ── Azure AI Foundry agent collector ─────────────────────────────────────────
# Setting the endpoint enables the collector.
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_POLL_INTERVAL_MS=60000


# ── Copilot Studio collector (Dataverse) ─────────────────────────────────────
# Setting the org URL enables the collector. The app registration needs an Application
# User with the "Bot Transcript Viewer" role in the Dataverse environment.
# DATAVERSE_ORG_URL=https://<org>.crm.dynamics.com
# Optional: only ingest this bot (GUID).
# COPILOT_BOT_ID=
# COPILOT_POLL_INTERVAL_MS=300000


# ── Governance core ──────────────────────────────────────────────────────────
# local = desktop enforcer (SQLite, loopback); cloud = central control plane (Cosmos/Redis/Entra).
# AGENT_MONITOR_MODE=local
# Master switch for inline enforcement; false forces every decision to observe.
# GOVERNANCE_ENFORCE=true
# Lanes-as-code folder (default: <cwd>/lanes).
# GOVERNANCE_LANES_DIR=
# Policies-as-code folder (default: <cwd>/policies).
# GOVERNANCE_POLICIES_DIR=
# Re-activate changed lane YAML files automatically. Default: a new lane file is activated, but edits
# to an existing lane are stored as a proposal for review.
# GOVERNANCE_LANES_AUTO_ACTIVATE=false
# Tenant id for partitioning in cloud mode (default: AZURE_TENANT_ID, then "default").
# GOVERNANCE_TENANT_ID=
# What hooks do when the decision pipeline errors: open | closed.
# AGENT_GOVERNANCE_FAIL_MODE=open
# Deadline for blocking hook decisions (ms).
# HOOK_DEADLINE_MS=110000
# Optional static bearer token accepted as the local admin (for scripts/automation). Without it,
# admin access uses the one-time login link printed at startup.
# GOVERNANCE_LOCAL_ADMIN_TOKEN=
# Comma-separated principal ids treated as the Guardian agent on the MCP server.
# GOVERNANCE_GUARDIAN_PRINCIPALS=
# Stable device id reported to the control plane (default: computer name).
# GOVERNANCE_DEVICE_ID=


# ── LLM judge (Azure OpenAI / Foundry) ───────────────────────────────────────
# Setting an endpoint enables the judge. Without an API key, DefaultAzureCredential is used.
# FOUNDRY_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# FOUNDRY_OPENAI_API_KEY=
# FOUNDRY_OPENAI_API_VERSION=2024-10-21
# Fallbacks for the two settings above (also read by the intelligence service):
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# JUDGE_FAST_DEPLOYMENT=gpt-4.1-mini
# JUDGE_ESCALATION_DEPLOYMENT=gpt-5
# INTENT_DEPLOYMENT=gpt-4.1-mini
# JUDGE_FAST_TIMEOUT_MS=4000
# JUDGE_ESCALATION_TIMEOUT_MS=15000
# Pass thresholds for `scripts/eval-judge.ts`.
# JUDGE_EVAL_MIN_DENY_RECALL=0.9
# JUDGE_EVAL_MIN_DENY_PRECISION=0
# JUDGE_EVAL_MIN_ACCURACY=0


# ── Prompt Shields (Azure AI Content Safety) ─────────────────────────────────
# Setting the endpoint enables Prompt Shields. Without an API key, DefaultAzureCredential is used.
# CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# CONTENT_SAFETY_API_KEY=
# CONTENT_SAFETY_API_VERSION=2024-09-01
# CONTENT_SAFETY_TIMEOUT_MS=3000


# ── TypeSafe Jev (shadow mode) ───────────────────────────────────────────────
# Opt-in: setting a key sends lane/action context (shaped by each lane's judge.dataPolicy,
# redacted by default) to api.typesafe.ai. Jev runs in SHADOW mode only: it never changes a
# verdict; its answers are stored next to the real decision for benchmarking. See docs/jev.md.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Pin a versioned model (thresholds are tuned per version; the jev-latest alias moves).
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_MS=2000
# Threshold policy used to turn Jev answers into a verdict: strict | permissive
# JEV_POLICY=strict
# JEV_SHADOW=on
# judge = only actions that trigger the LLM judge; governed = every pre_tool/spawn decision
# JEV_SHADOW_SCOPE=judge
# JEV_SHADOW_SAMPLE_RATE=1
# JEV_MAX_CONCURRENCY=8
# JEV_MAX_QUEUE=500
# JEV_SHADOW_INJECTION=on
# JEV_SHADOW_SESSIONS=on
# JEV_SHADOW_SESSION_INTERVAL_MS=300000
# JEV_SHADOW_RETENTION_DAYS=30
# Where the dashboard reads offline benchmark results (default: <repo>/eval/results)
# JEV_EVAL_RESULTS_DIR=
# Optional Foundry list prices (USD per million tokens) for the cost comparison. FOUNDRY_PRICE_* prices the
# fast deployment; FOUNDRY_ESCALATION_PRICE_* the escalation one (falls back to FOUNDRY_PRICE_*).
# FOUNDRY_PRICE_INPUT_PER_MTOK=
# FOUNDRY_PRICE_OUTPUT_PER_MTOK=
# FOUNDRY_ESCALATION_PRICE_INPUT_PER_MTOK=
# FOUNDRY_ESCALATION_PRICE_OUTPUT_PER_MTOK=
# If the host has a managed identity without data-plane roles, pin DefaultAzureCredential to `az login`:
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential
# AgentMon Fleet (fleet/) also runs Jev in shadow mode when TYPESAFE_API_KEY is set (see docs/jev.md):
# FLEET_JEV_MODE=shadow
# FLEET_JEV_MODEL=jev-1.13.0
# FLEET_JEV_TIMEOUT_S=2.0
# FLEET_JEV_REALTIME_TIMEOUT_S=0.3
# FLEET_JEV_BUDGET_PER_CYCLE=2000
# FLEET_JEV_SHADOW_POST=true
# FLEET_JEV_SHADOW_JSONL=fleet-jev-shadow.jsonl


# ── AgentMon Fleet (fleet/, `agentmon-fleet`) ────────────────────────────────
# Python monitoring fleet for Foundry / Copilot Studio agents. See docs/fleet.md (config reference) and
# docs/fleet-sources.md (roles/consents). List values are JSON arrays. FLEET_JEV_* settings are in the TypeSafe
# block above; the fleet also accepts FLEET_TYPESAFE_API_KEY / FLEET_TYPESAFE_BASE_URL (or TYPESAFE_API_KEY/_BASE_URL).
# Identity (client secret for local runs only; in Azure the managed identity is used)
# FLEET_AZURE_TENANT_ID=<tenant-guid>
# FLEET_AZURE_CLIENT_ID=<app-id>
# FLEET_AZURE_CLIENT_SECRET=
# FLEET_MANAGED_IDENTITY_CLIENT_ID=
# FLEET_SUBSCRIPTION_ID=<subscription-guid>
# Models (Foundry project endpoint is also polled as a monitored project)
# FLEET_FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FLEET_FOUNDRY_RESOURCE_ID=
# FLEET_FOUNDRY_API_KEY=
# FLEET_MODEL_DEPLOYMENT=gpt-5.5
# FLEET_FAST_MODEL_DEPLOYMENT=gpt-4.1-mini
# FLEET_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# FLEET_LLM_ENABLED=true
# FLEET_LLM_TIMEOUT_S=60
# FLEET_FAST_LLM_TIMEOUT_S=0.6
# minimal | low | medium | high
# FLEET_REASONING_EFFORT=low
# Log sources (workspace GUID, not the resource id; storage account name only)
# FLEET_LAW_WORKSPACE_ID=<workspace-guid>
# FLEET_LAW_RESOURCE_ID=
# FLEET_APPINSIGHTS_RESOURCE_ID=
# FLEET_STORAGE_ACCOUNT=
# FLEET_DATAVERSE_ORG_URL=https://<org>.crm.dynamics.com
# FLEET_PP_ENVIRONMENT_ID=
# Discovery scope
# FLEET_SCOPE_SUBSCRIPTIONS=["<subscription-guid>"]
# FLEET_FOUNDRY_PROJECTS=[]
# FLEET_CONTENT_PROJECTS=[]
# FLEET_CHARTER_DIR=
# Sinks: Logs Ingestion (DCE + DCR immutable id → AgentMonAlerts_CL), dashboard, local JSONL
# FLEET_ALERTS_DCE=https://<dce-name>.<region>.ingest.monitor.azure.com
# FLEET_ALERTS_DCR_ID=dcr-<immutable-id>
# FLEET_ALERTS_STREAM=Custom-AgentMonAlerts
# FLEET_MONITOR_URL=http://127.0.0.1:4317
# FLEET_MONITOR_TOKEN=
# FLEET_APPINSIGHTS_CONNECTION_STRING=
# Runtime
# FLEET_STATE_DB=fleet-state.db
# FLEET_POLL_INTERVAL_S=120
# FLEET_LOOKBACK_MINUTES=1440
# FLEET_OVERLAP_MINUTES=45
# informational | low | medium | high | critical
# FLEET_MIN_ALERT_SEVERITY=low
# FLEET_LLM_BUDGET_PER_CYCLE=60
# FLEET_REDACT_PII=true
# FLEET_EVENTS_JSONL=
# FLEET_ALERTS_JSONL=fleet-alerts.jsonl
# Inference / network sentinel
# FLEET_KNOWN_CALLERS=["<entra-object-id>"]
# FLEET_INFERENCE_HOURLY_TOKEN_ALERT=250000
# FLEET_DENIED_BURST_THRESHOLD=20
# FLEET_NETWORK_ALLOWED_DESTINATIONS=[]
# Tenant collectors (off by default; each needs admin-consented app permissions, see docs/fleet-sources.md)
# FLEET_TENANT_PURVIEW=false
# FLEET_PURVIEW_START_SUBSCRIPTION=false
# FLEET_TENANT_ENTRA=false
# FLEET_TENANT_DEFENDER=false
# Real-time hooks (`agentmon-fleet hooks`, docs/fleet-realtime-hooks.md)
# FLEET_HOOKS_AUDIENCE=["https://<hooks-host>/copilot-studio","<app-id-guid>"]
# FLEET_HOOKS_ALLOWED_APP_IDS=["<copilot-studio-fic-app-id>"]
# FLEET_HOOKS_ALLOW_ANONYMOUS=false
# FLEET_HOOKS_TOKEN=
# FLEET_HOOKS_BLOCK_THRESHOLD=70
# observe | enforce (default for agents whose YAML charter doesn't set `enforce`; a YAML enforce: true/false wins)
# FLEET_HOOKS_MODE=observe
# FLEET_HOOKS_DEADLINE_MS=850
# Scenario runner (read from the process environment only, not from this file)
# FLEET_SCENARIO_RUNS_DIR=scenario-runs
# FLEET_SCENARIO_DIRECTLINE_URL=https://directline.botframework.com
# FLEET_SCENARIO_CS_HR_TOKEN_URL=
# FLEET_SCENARIO_CS_ITOPS_TOKEN_URL=


# ── Cloud control plane & sync ───────────────────────────────────────────────
# Local enforcer → control plane: base URL and the device token issued at enrollment.
# GOVERNANCE_CONTROL_PLANE_URL=
# GOVERNANCE_DEVICE_TOKEN=
# GOVERNANCE_SYNC_INTERVAL_MS=15000
# Control plane only: HMAC key used to sign/verify device tokens.
# GOVERNANCE_DEVICE_SIGNING_KEY=
# Control plane storage. Cosmos uses DefaultAzureCredential unless COSMOS_KEY is set.
# COSMOS_ENDPOINT=
# COSMOS_DATABASE=agentgov
# COSMOS_KEY=
# REDIS_URL=


# ── Entra ID authentication ──────────────────────────────────────────────────
# API app id / audience for tokens presented to the control plane and /mcp.
# ENTRA_API_AUDIENCE=api://<api-app-id>
# Dashboard (SPA) app registration client id (default: the API audience).
# ENTRA_SPA_CLIENT_ID=
# Tenant (default: AZURE_TENANT_ID).
# ENTRA_TENANT_ID=
# Local mode: trust loopback callers as the `local` principal with all roles.
# GOVERNANCE_TRUST_LOOPBACK=true


# ── Alerts ───────────────────────────────────────────────────────────────────
# TEAMS_WEBHOOK_URL=
# Comma-separated generic webhook URLs; bodies are HMAC-SHA256 signed with ALERT_WEBHOOK_SECRET
# (both are required to enable webhook alerts).
# ALERT_WEBHOOK_URLS=
# ALERT_WEBHOOK_SECRET=
# Email via Azure Communication Services (DefaultAzureCredential).
# ACS_ENDPOINT=https://<resource>.communication.azure.com
# ALERT_EMAIL_FROM=
# Comma-separated recipients.
# ALERT_EMAIL_TO=
# Public dashboard URL used in deep links (Teams cards, emails).
# DASHBOARD_PUBLIC_URL=
# Teams approval bot: Bot Framework app id and the Entra object ids allowed to approve.
# TEAMS_BOT_APP_ID=
# TEAMS_APPROVER_OBJECT_IDS=


# ── Intelligence service link (server side) ──────────────────────────────────
# Base URL of the Python intelligence service (Guardian, lane drafter, chat).
# INTELLIGENCE_URL=http://127.0.0.1:8000


# ── Governance MCP gateway (npm run gateway) ─────────────────────────────────
# AGENT_GATEWAY_CONFIG=./agent-gateway.json
# AGENT_GATEWAY_PDP_URL=http://127.0.0.1:4317
# Static bearer for the PDP (the variable name can be changed with `pdpTokenEnv` in the config file).
# AGENT_GATEWAY_PDP_TOKEN=
# Use a managed-identity token for this audience instead of a static token.
# AGENT_GATEWAY_PDP_AUDIENCE=
# Inbound auth for the HTTP gateway.
# AGENT_GATEWAY_AUDIENCE=
# AGENT_GATEWAY_ALLOW_ANONYMOUS=false
# AGENT_GATEWAY_PORT=4127
# GATEWAY_HOST=127.0.0.1
# Caller identity for `--stdio` mode (usually set per agent by the MCP client instead).
# AGENT_GATEWAY_AUTHORIZATION=
# AGENT_SURFACE=
# AGENT_ID=
# AGENT_NAME=
# AGENT_USER=
# AGENT_SESSION_ID=


# ── Web UI (Vite) ────────────────────────────────────────────────────────────
# Where `npm run dev:web` proxies /api, /ingest, /health and /live. The Copilot CLI / VS Code hook forwarders
# (scripts/copilot-hook-forward.*) also post to this base URL when set (read from the process environment).
# AGENT_MONITOR_URL=http://127.0.0.1:4317
# Port the hook forwarders use when AGENT_MONITOR_URL is not set (process environment of the agent; default 4317).
# AGENT_MONITOR_PORT=4317
# Entra sign-in fallback when the server's auth-config endpoint is unavailable.
# VITE_* values are embedded in the built UI at `npm run build` — never put secrets here.
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_AUDIENCE=


# ── Intelligence service (intelligence/) ─────────────────────────────────────
# Also reads AZURE_OPENAI_ENDPOINT, ENTRA_API_AUDIENCE and the Azure credentials above.
# FOUNDRY_PROJECT_ENDPOINT=
# GUARDIAN_DEPLOYMENT=gpt-5
# CHAT_DEPLOYMENT=gpt-4.1
# DRAFTER_DEPLOYMENT=gpt-4.1
# MONITOR_MCP_URL=http://127.0.0.1:4317/mcp
# MONITOR_API_URL=http://127.0.0.1:4317
# MONITOR_TOKEN=
# recommend | contain | autonomous
# GUARDIAN_AUTHORITY=recommend
# GUARDIAN_POLL_SECONDS=30
# GUARDIAN_ENABLED=true
# APPLICATIONINSIGHTS_CONNECTION_STRING=
