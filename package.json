{
  "name": "agent-logs-monitor",
  "version": "0.1.0",
  "description": "Local web app that monitors Claude Code and Copilot agent activity",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "electron:dev": "SET ELECTRON_RUN_AS_NODE=&& electron .",
    "electron:build": "tsc && electron-builder --win --publish never"
  },
  "dependencies": {
    "@azure/identity": "^4.4.0",
    "express": "^4.18.3",
    "sql.js": "^1.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.10",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "build": {
    "appId": "com.agent-monitor",
    "productName": "Agent Monitor",
    "main": "electron/main.js",
    "files": [
      "electron/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/server.js",
        "to": "server.js"
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
