{
  "name": "agent-logs-monitor",
  "version": "0.1.0",
  "description": "Monitoring and governance platform for AI agents: endpoint coding agents, Microsoft Foundry and Copilot Studio",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:server": "tsc",
    "build:web": "npm --prefix web run build",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "test": "vitest run",
    "test:web": "npm --prefix web test",
    "postinstall": "npm --prefix web install --no-audit --no-fund",
    "electron:dev": "SET ELECTRON_RUN_AS_NODE=&& electron .",
    "electron:build": "npm run build && electron-builder --win --publish never",
    "electron:pack": "npm run build && electron-builder --win --dir --publish never",
    "mcp": "node dist/governance/mcp/stdio.js",
    "gateway": "node dist/gateway/main.js",
    "test:gov": "vitest run test/governance",
    "eval:redteam": "vitest run test/redteam",
    "eval:compare": "ts-node scripts/eval-compare.ts",
    "posture": "node dist/posture/cli.js"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/identity": "^4.4.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "compression": "^1.8.2",
    "express": "^4.18.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "ws": "^8.16.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.5.10",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.agent-monitor",
    "productName": "Agent Monitor",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/**/*",
      "scripts/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "win": {
      "icon": "electron/assets/app-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
