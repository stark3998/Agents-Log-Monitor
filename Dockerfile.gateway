# syntax=docker/dockerfile:1.7
# Governance MCP gateway: proxies MCP tools/list + tools/call through the PDP, scans results.
# Build:  docker build -f Dockerfile.gateway -t agentgov/mcp-gateway:<git-sha> .
# Config: AGENT_GATEWAY_CONFIG=/app/config/<file> (agent-gateway.json; mounted from Key Vault in Azure).

ARG NODE_IMAGE=node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS build
WORKDIR /src
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm_config_fund=false npm_config_audit=false npm_config_update_notifier=false
COPY package.json package-lock.json ./
# --ignore-scripts: skips electron + the web UI postinstall (the gateway has no UI).
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npx tsc -p tsconfig.json

FROM ${NODE_IMAGE} AS prod-deps
WORKDIR /app
ENV npm_config_fund=false npm_config_audit=false npm_config_update_notifier=false
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts

FROM ${NODE_IMAGE} AS runtime
LABEL org.opencontainers.image.title="agentgov-mcp-gateway" \
      org.opencontainers.image.source="https://github.com/stark3998/Agents-Log-Monitor"

ENV NODE_ENV=production \
    GATEWAY_HOST=0.0.0.0 \
    AGENT_GATEWAY_PORT=8080 \
    AGENT_GATEWAY_CONFIG=/app/config/agent-gateway.json

WORKDIR /app
RUN apk upgrade --no-cache \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && mkdir -p /app/config

COPY package.json ./
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /src/dist ./dist
# No config file baked in: a missing AGENT_GATEWAY_CONFIG file means "no upstreams" (safe default).

USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.AGENT_GATEWAY_PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "dist/gateway/main.js"]
